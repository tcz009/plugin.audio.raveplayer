<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <category id="general" label="General">
        <setting id="results_per_page" type="select" label="Rows per page (all lists)" default="50">
            <options>
                <option label="25">25</option>
                <option label="50">50</option>
                <option label="100">100</option>
            </options>
        </setting>
        <setting id="episode_limit" type="number" label="Maximum episodes per podcast feed (5000 = all)" default="5000"/>
        <setting id="radio_limit" type="number" label="Maximum live stations" default="500"/>
        <setting id="hide_empty_feeds" type="bool" label="Hide podcast feeds with no episodes" default="false"/>
        <setting id="spinner_overlay" type="bool" label="Spinning-head download window (prototype)" default="false"/>
        <setting id="spinner_tuning" type="bool" label="Show spinner while tuning streams" default="true"/>
        <setting id="surprise_animate" type="bool" label="Animate Surprise Me" default="true"/>
        <setting id="rtp_egress_proxy" type="text" label="RaveTapePacks egress proxy (host:port, blank = direct)" default=""/>
    </category>
    <category id="resolver" label="Resolver (Mediafire / Drive / Podomatic / Mega)">
        <setting id="resolver_service_url" type="text" label="NAS resolver URL (LAN/Tailscale base, blank = in-process only)" default=""/>
        <setting id="resolver_service_token" type="text" label="Service token (Bearer; preferred over the cookie)" default="" option="hidden"/>
        <setting id="resolver_service_cookie" type="text" label="Web session cookie (fallback auth, e.g. raveplayer_session=...)" default="" option="hidden"/>
        <setting id="resolver_enable_mega" type="bool" label="Enable Mega links" default="false"/>
    </category>
</settings>
